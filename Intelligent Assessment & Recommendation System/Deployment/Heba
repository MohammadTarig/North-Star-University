# Flask routes
@app.route('/')
def index():
    return html_template

@app.route('/upload', methods=['POST'])
def upload_file():
    if 'file' not in request.files:
        return jsonify({'error': 'No file uploaded'}), 400

    file = request.files['file']
    if file.filename == '':
        return jsonify({'error': 'No file selected'}), 400

    try:
        image_data = file.read()
        extracted_text = extract_text_from_image(image_data)

        if not extracted_text:
            return jsonify({'error': 'Failed to extract text from image'}), 500

        processed_text = preprocess_text(extracted_text)
        quiz_data = generate_quiz_questions(processed_text)

        if 'error' in quiz_data:
            return jsonify({'error': quiz_data['error']}), 500

        session['quiz_data'] = quiz_data
        session['current_question'] = 0
        session['score'] = 0

        return jsonify({
            'success': True,
            'topic': quiz_data.get('topic', 'Unknown topic'),
            'question_count': len(quiz_data.get('questions', []))
        })

    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/question')
def get_question():
    quiz_data = session.get('quiz_data')
    if not quiz_data:
        return jsonify({'error': 'No quiz data found'}), 400

    current_question = session.get('current_question', 0)
    questions = quiz_data.get('questions', [])

    if current_question >= len(questions):
        return jsonify({'completed': True, 'score': session.get('score', 0)})

    question_data = questions[current_question]
    question_for_client = {
        'question': question_data.get('question', ''),
        'options': question_data.get('options', [])
    }

    return jsonify({
        'question_number': current_question + 1,
        'total_questions': len(questions),
        'question': question_for_client
    })

@app.route('/answer', methods=['POST'])
def submit_answer():
    data = request.get_json()
    user_answer = data.get('answer', '').strip().lower()

    quiz_data = session.get('quiz_data')
    if not quiz_data:
        return jsonify({'error': 'No quiz data found'}), 400

    current_question = session.get('current_question', 0)
    questions = quiz_data.get('questions', [])

    if current_question >= len(questions):
        return jsonify({'error': 'No more questions'}), 400

    current_question_data = questions[current_question]
    correct_answer_letter = current_question_data.get('correct_answer', '').lower()

    correct_answer_text = ""
    for option in current_question_data.get('options', []):
        if option.startswith(correct_answer_letter + "."):
            correct_answer_text = option[3:].strip()
            break

    evaluation = evaluate_answer(user_answer, correct_answer_text)

    if evaluation['correct']:
        session['score'] = session.get('score', 0) + 1

    session['current_question'] = current_question + 1

    return jsonify({
        'correct': evaluation['correct'],
        'feedback': evaluation['feedback'],
        'score': session.get('score', 0)
    })

@app.route('/results')
def get_results():
    quiz_data = session.get('quiz_data')
    if not quiz_data:
        return jsonify({'error': 'No quiz data found'}), 400

    total_questions = len(quiz_data.get('questions', []))
    score = session.get('score', 0)
    percentage = (score / total_questions) * 100 if total_questions > 0 else 0

    return jsonify({
        'score': score,
        'total_questions': total_questions,
        'percentage': round(percentage, 2),
        'passed': percentage >= 70
    })

@app.route('/reset')
def reset_quiz():
    session.clear()
    return jsonify({'success': True})

